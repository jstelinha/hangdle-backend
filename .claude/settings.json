{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Bash(cat .env:*)",
      "Bash(type .env:*)",
      "Bash(more .env:*)",
      "Bash(less .env:*)",
      "Bash(head .env:*)",
      "Bash(tail .env:*)",
      "Bash(grep * .env:*)",
      "Bash(printenv:*)",
      "Bash(docker compose config:*)",
      "Bash(docker-compose config:*)",
      "Bash(docker inspect:*)",
      "Bash(docker exec *env*)",
      "Bash(docker container exec *env*)",
      "Bash(docker compose exec *env*)",
      "Bash(docker-compose exec *env*)",
      "Bash(docker compose run *env*)",
      "Bash(docker-compose run *env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(gc *.env*)",
      "PowerShell(cat *.env*)",
      "PowerShell(type *.env*)",
      "PowerShell(Select-String *.env*)",
      "PowerShell(sls *.env*)",
      "PowerShell(docker compose config *)",
      "PowerShell(docker-compose config *)",
      "PowerShell(docker inspect *)",
      "PowerShell(docker exec *env*)",
      "PowerShell(docker container exec *env*)",
      "PowerShell(docker compose exec *env*)",
      "PowerShell(docker-compose exec *env*)",
      "PowerShell(docker compose run *env*)",
      "PowerShell(docker-compose run *env*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker compose down --volumes:*)",
      "Bash(docker volume rm:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)"
    ],
    "ask": [
      "Bash(git push:*)",
      "PowerShell(git push *)"
    ]
  }
}
